<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: __GAIA_DIR__ is replaced at install time. See the tutorial, step "Run it on a schedule". -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gaia.nightly</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string>
    <string>cd __GAIA_DIR__ &amp;&amp; bin/gaia nightly</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/gaia-nightly.log</string>
  <key>StandardErrorPath</key><string>/tmp/gaia-nightly.log</string>
</dict></plist>
