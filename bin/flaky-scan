#!/usr/bin/env bash
# bin/flaky-scan <repo> [--file]  — deterministic flaky-test detector (no model in the loop).
# Pulls JUnit artifacts from recent completed CI runs on the base branch, accumulates per-test outcomes in
# runs/_flaky/<repo>.json, and reports tests whose failure rate crosses the threshold. --file opens ONE GitHub issue.
# gaia.json: repos[].ci = {workflow: "ci.yml", junit_artifact: "junit-*"}
# Env: FLAKY_RUNS=30 FLAKY_MIN_RUNS=5 FLAKY_RATE=0.05
set -euo pipefail
. "$(dirname "$0")/lib.sh"
repo=${1:?repo}; file=${2:-}; S="$F/runs/_flaky"; mkdir -p "$S"
wf=$(repo_get "$repo" '.ci.workflow'); art=$(repo_get "$repo" '.ci.junit_artifact' 'junit*')
[ -n "$wf" ] || { echo "flaky-scan: $repo has no ci.workflow in gaia.json — skip"; exit 0; }
db="$S/$repo.json"; [ -f "$db" ] || echo '{"seen_runs":[],"tests":{}}' > "$db"
gh_repo=$(git -C "$(repo_path "$repo")" remote get-url "$(git_remote)" | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')
for id in $(gh run list -R "$gh_repo" --branch "$(repo_get "$repo" '.base' "$(git_base)")" --workflow "$wf" --status completed -L "${FLAKY_RUNS:-30}" --json databaseId -q '.[].databaseId'); do
  jq -e --arg id "$id" '.seen_runs | index($id|tonumber)' "$db" >/dev/null && continue
  tmp=$(mktemp -d); gh run download "$id" -R "$gh_repo" -p "$art" -D "$tmp" >/dev/null 2>&1 || true
  find "$tmp" -name '*.xml' -print0 | while IFS= read -r -d '' x; do
    python3 -I - "$x" "$db" <<'PY'
import sys, json, xml.etree.ElementTree as ET
x, db = sys.argv[1], sys.argv[2]; d = json.load(open(db))
for tc in ET.parse(x).iter("testcase"):
    k = f'{tc.get("classname")}::{tc.get("name")}'; s = d["tests"].setdefault(k, {"runs": 0, "fails": 0})
    if tc.find("skipped") is not None: continue
    s["runs"] += 1; s["fails"] += int(tc.find("failure") is not None or tc.find("error") is not None)
json.dump(d, open(db, "w"))
PY
  done; rm -rf "$tmp"
  tmpj=$(mktemp); jq --argjson id "$id" '.seen_runs += [$id]' "$db" > "$tmpj" && mv "$tmpj" "$db"
done
report=$(jq -r --argjson m "${FLAKY_MIN_RUNS:-5}" --argjson r "${FLAKY_RATE:-0.05}" '.tests | to_entries
  | map(select(.value.runs >= $m and .value.fails > 0 and (.value.fails/.value.runs) >= $r and .value.fails < .value.runs))
  | sort_by(-(.value.fails/.value.runs)) | .[] | "- `\(.key)` — \(.value.fails)/\(.value.runs) failed (\((100*.value.fails/.value.runs)|floor)%)"' "$db")
[ -z "$report" ] && { echo "no flaky tests over threshold ($repo)"; exit 0; }
echo "$report"
if [ "$file" = "--file" ]; then
  gh issue list -R "$gh_repo" --label flaky-test --state open --json number -q '.[0].number' | grep -q . && { echo "open flaky-test issue exists; not filing"; exit 0; }
  gh issue create -R "$gh_repo" --label flaky-test --title "Flaky tests detected on the base branch (gaia flaky-scan)" \
    --body "$(printf 'Intermittent failures across completed CI runs (JUnit artifacts):\n\n%s\n\n_Generated by gaia bin/flaky-scan._' "$report")"
fi
