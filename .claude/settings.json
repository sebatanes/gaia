{
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker ps:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push origin feat/:*)",
      "Bash(git worktree:*)",
      "Bash(git -C:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run download:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(./bin/:*)",
      "Bash(bin/:*)",
      "mcp__playwright"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Edit(docs/vision.md)",
      "Write(docs/vision.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Edit|Write|mcp__.*", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-run.sh" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" } ] }
    ]
  }
}
